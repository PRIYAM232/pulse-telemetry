# Multi-stage build for the otelcol-pulse distribution.
# Build context must be the repository root:
#   docker build -f deploy/docker/Dockerfile.collector -t pulse/otelcol-pulse:dev .

# OCB v0.156.0 requires go >= 1.25, and the official images pin
# GOTOOLCHAIN=local — the base image's toolchain is the one that runs.
FROM golang:1.26 AS build

ARG OCB_VERSION=v0.156.0
RUN go install go.opentelemetry.io/collector/cmd/builder@${OCB_VERSION}

WORKDIR /src
COPY data-plane/ ./data-plane/

# CGO off → fully static binary, safe for distroless.
ENV CGO_ENABLED=0
RUN cd data-plane && /go/bin/builder --config builder-config.yaml

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /src/data-plane/dist/otelcol-pulse /otelcol-pulse
COPY data-plane/config/otelcol-dev.yaml /etc/otelcol/config.yaml

# OTLP gRPC / OTLP HTTP
EXPOSE 4317 4318

ENTRYPOINT ["/otelcol-pulse"]
CMD ["--config", "/etc/otelcol/config.yaml"]
