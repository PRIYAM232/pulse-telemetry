{
  "__inputs": [],
  "annotations": { "list": [] },
  "description": "Self-monitoring for the Pulse observability proxy: otelcol-pulse process health, synced ruleset size, and per-signal throughput/drops from the pulse_filter engine. Metric names assume the chart's telemetry reader config (classic collector names, no _total/unit suffixes).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Collector process",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "CPU consumed by each collector pod. otelcol_process_cpu_seconds is cumulative; the rate is cores in use.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "none",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(otelcol_process_cpu_seconds{pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "CPU usage (cores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Resident set size per collector pod. Compare against the collector container's memory limit.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "otelcol_process_memory_rss{pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Memory RSS",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": [],
      "title": "Pulse engine",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rules in the currently synced pulse_filter ruleset. 0 with traffic flowing means the collector cannot reach the control plane (or the fleet has no enabled rules).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(otelcol_pulse_filter_rules{pod=~\"$pod\"})",
          "legendFormat": "rules",
          "refId": "A"
        }
      ],
      "title": "Active rules synced",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Share of incoming telemetry (spans + log records + metrics) removed by pulse_filter rules — the proxy's cost-savings knob, and the number to watch after a rule change.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * (sum(rate(otelcol_pulse_filter_spans_dropped{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_pulse_filter_logs_dropped{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_pulse_filter_metrics_dropped{pod=~\"$pod\"}[$__rate_interval]))) / (sum(rate(otelcol_pulse_filter_spans_received{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_pulse_filter_logs_received{pod=~\"$pod\"}[$__rate_interval])) + sum(rate(otelcol_pulse_filter_metrics_received{pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "dropped",
          "refId": "A"
        }
      ],
      "title": "Drop ratio (all signals)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry entering pulse_filter across all collector pods, per signal.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_pulse_filter_spans_received{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_pulse_filter_logs_received{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_pulse_filter_metrics_received{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metrics",
          "refId": "C"
        }
      ],
      "title": "Received /s (by signal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry removed by pulse_filter rules (DROP, SAMPLE, THROTTLE), per signal.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_pulse_filter_spans_dropped{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_pulse_filter_logs_dropped{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_pulse_filter_metrics_dropped{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metrics",
          "refId": "C"
        }
      ],
      "title": "Dropped by rules /s (by signal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Telemetry the OTLP receiver refused (backpressure / bad payloads). Non-zero here means producers are losing data BEFORE pulse_filter ever sees it.",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_receiver_refused_spans{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_receiver_refused_log_records{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(otelcol_receiver_refused_metric_points{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metric points",
          "refId": "C"
        }
      ],
      "title": "OTLP receiver refusals /s",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pulse", "opentelemetry", "self-monitoring"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "pod",
        "label": "Collector pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(otelcol_process_uptime, pod)",
        "current": {},
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Pulse — Collector Self-Monitoring",
  "uid": "pulse-collector-health",
  "version": 1
}
